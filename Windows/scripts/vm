#!/bin/bash
# Drives the Windows VM used to build and test the WinUI backend, from the Mac, over SSH
# (OpenSSH server in the VM, key auth; the default shell is PowerShell).
#   vm ip                      the VM's address (WINDOWS_VM_HOST[:WINDOWS_VM_PORT], else 127.0.0.1:2222 when
#                              ~/Downloads/VMs/Windows-qemu.sh runs it, else the UTM shared-network lease)
#   vm ssh <powershell…>       runs a command in the VM
#   vm sync                    copies this package's sources to C:\dev\SwiftUI (no .build/.git)
#   vm build [args…]           sync + Windows/scripts/build-app.ps1 [args…]
#   vm run <exe> [args…]       runs a program on the VM's desktop (interactive session) and waits
#   vm screenshot <local.png>  captures the VM's desktop
#   vm pull <remote> <local>   copies a file from the VM
#   vm click <x> <y> | keys <SendKeys> | text <text>   real input on the VM's desktop (physical px)
#   vm steps "click:146,72; wait:400; click:204,175"  several inputs in one go (menus stay open)
#   vm last <local.png>        the screenshot taken right after the last input
set -e
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
MAC="${WINDOWS_VM_MAC:-02:57:57:0a:11:01}"
USER_NAME="${WINDOWS_VM_USER:-v57}"
REMOTE='C:\dev\SwiftUI'

if [ -z "$WINDOWS_VM_HOST" ] && pgrep -f "qemu-system-aarch64 -name Windows" >/dev/null; then
  WINDOWS_VM_HOST=127.0.0.1; WINDOWS_VM_PORT="${WINDOWS_VM_PORT:-2222}"
fi
PORT="${WINDOWS_VM_PORT:-22}"

vm_ip() {
  if [ -n "$WINDOWS_VM_HOST" ]; then echo "$WINDOWS_VM_HOST"; return; fi
  # macOS vmnet DHCP leases store the MAC without leading zeros (02:57:57:0a:11:01 → 2:57:57:a:11:1).
  local short; short="$(echo "$MAC" | tr 'A-F' 'a-f' | sed -E 's/(^|:)0([0-9a-f])/\1\2/g')"
  awk -v mac="1,$short" '/ip_address=/{ip=substr($0, index($0,"=")+1)} /hw_address=/{if (substr($0, index($0,"=")+1)==mac) print ip}' /var/db/dhcpd_leases | head -1
}

SSH_OPTS=(-o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 -o ServerAliveInterval=30 -o UserKnownHostsFile="$HOME/.ssh/known_hosts_swiftui_windows")
remote() { ssh "${SSH_OPTS[@]}" -p "$PORT" "$USER_NAME@$(vm_ip)" "$@"; }
copy() { scp -q "${SSH_OPTS[@]}" -P "$PORT" "$@"; }

case "$1" in
  ip) vm_ip ;;
  ssh) shift; remote "$@" ;;
  sync)
    TAR="$(mktemp -t swiftui-src).tar"
    COPYFILE_DISABLE=1 tar -h -C "$ROOT" --exclude .build --exclude .git --exclude '.build-*' --exclude 'Android/build' \
      --exclude 'Android/*/build' --exclude '*/bin' --exclude '*/obj' --exclude .swiftpm -cf "$TAR" .
    copy "$TAR" "$USER_NAME@$(vm_ip):C:/dev/swiftui-src.tar"
    rm -f "$TAR"
    remote "New-Item -ItemType Directory -Force '$REMOTE' | Out-Null; tar -xf C:/dev/swiftui-src.tar -C '$REMOTE'; Remove-Item C:/dev/swiftui-src.tar"
    ;;
  build) shift; "$0" sync; remote "& '$REMOTE\\Windows\\scripts\\build-app.ps1' $*" ;;
  run)
    shift; exe="$1"; shift
    remote "& '$REMOTE\\Windows\\scripts\\run-interactive.ps1' -Command '$exe' -Arguments '$*'"
    ;;
  screenshot)
    remote "& '$REMOTE\\Windows\\scripts\\run-interactive.ps1' -Command powershell.exe -Arguments '-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File $REMOTE\\Windows\\scripts\\screenshot.ps1 -Path C:\\dev\\screen.png' -TimeoutSeconds 60" >/dev/null
    copy "$USER_NAME@$(vm_ip):C:/dev/screen.png" "$2"
    echo "$2"
    ;;
  pull) copy "$USER_NAME@$(vm_ip):$2" "$3" ;;
  click|keys|text|steps)
    case "$1" in click) args="-X $2 -Y $3" ;; keys) args="-Keys \"$2\"" ;; text) args="-Text \"$2\"" ;; steps) args="-Steps \"$2\"" ;; esac
    remote "& '$REMOTE\\Windows\\scripts\\run-interactive.ps1' -Command powershell.exe -Arguments '-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File $REMOTE\\Windows\\scripts\\input.ps1 $args -Shot C:\\dev\\last.png' -TimeoutSeconds 30" >/dev/null
    ;;
  last) copy "$USER_NAME@$(vm_ip):C:/dev/last.png" "$2"; echo "$2" ;;
  *) sed -n '2,10p' "$0"; exit 1 ;;
esac
