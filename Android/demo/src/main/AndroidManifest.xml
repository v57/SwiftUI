<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="${appLabel}"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        android:hardwareAccelerated="true">
        <!-- simpleperf / Perfetto can profile release builds. -->
        <profileable android:shell="true" />
        <activity
            android:name="dev.v57.swiftui.SwiftUIActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode|locale|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize">
            <!-- The Swift app library (lib<name>.so) whose @main App runs in this activity. -->
            <meta-data android:name="dev.v57.swiftui.library" android:value="${swiftLibrary}" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
