#!/bin/bash
# Downloads the Material Symbols variable font (Apache 2.0, google/material-design-icons) that the
# Android backend uses for Image(systemName:) — SF Symbols can't be shipped on Android.
set -e
DIR="$(cd "$(dirname "$0")/.." && pwd)/swiftui/src/main/assets"
mkdir -p "$DIR"
FONT="$DIR/MaterialSymbolsOutlined.ttf"
if [ ! -s "$FONT" ]; then
  curl -sSL -o "$FONT.tmp" 'https://raw.githubusercontent.com/google/material-design-icons/master/variablefont/MaterialSymbolsOutlined%5BFILL%2CGRAD%2Copsz%2Cwght%5D.ttf'
  mv "$FONT.tmp" "$FONT"
  curl -sSL -o "$DIR/MaterialSymbols-LICENSE.txt" 'https://raw.githubusercontent.com/google/material-design-icons/master/LICENSE'
fi
ls -la "$FONT"
