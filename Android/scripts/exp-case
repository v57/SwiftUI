#!/bin/bash
# Runs a Ports/Exp case on the device (ExpAndroid must be installed: build-app --package-path
# Ports/Exp --product ExpAndroid) and on macOS (Exp2 = SwiftUI2/AppKit, ExpApple = Apple SwiftUI),
# then prints the probe geometry side by side (origin-normalized). Outputs in /tmp/sui2/<case>.*
# Usage: Android/scripts/exp-case <case> [--no-mac]
set -e
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
CASE="$1"; OUT=/tmp/sui2; mkdir -p "$OUT"
D="$ROOT/Android/scripts/device"
"$D" logcat -c
"$D" shell am start -S -n org.swiftui2.expandroid/org.swiftui2.SwiftUI2Activity -e env.EXP_CASE "$CASE" --ei org.swiftui2.dump 2500 >/dev/null
sleep 4
"$D" shot "$OUT/$CASE-android.png"
"$D" logcat -d -s SwiftUI2.stdout:I | sed -n 's/.*PROBE /PROBE /p' > "$OUT/$CASE-android.probes"
"$D" logcat -d -s SwiftUI2Dump:I | sed 's/^.*SwiftUI2Dump: //' > "$OUT/$CASE-android.tree"
if [ "$2" != --no-mac ]; then
  cd "$ROOT/Ports/Exp"
  for exe in Exp2 ExpApple; do
    swift build --product $exe >/dev/null 2>&1 || true
    EXP_CASE="$CASE" SWIFTUI2_SNAPSHOT="$OUT/$CASE-$exe.png" SWIFTUI2_SNAPSHOT_DELAY=2 SWIFTUI2_SNAPSHOT_EXIT=1 \
      perl -e 'alarm shift; exec @ARGV' 6 .build/debug/$exe 2>/dev/null | grep PROBE > "$OUT/$CASE-$exe.probes" || true
  done
fi
python3 - "$OUT/$CASE" <<'PY'
import sys, collections
base = sys.argv[1]
def load(name):
    probes = collections.OrderedDict()
    try:
        for line in open(f"{base}-{name}.probes"):
            p = line.split()
            if len(p) == 6: probes[p[1]] = tuple(float(v) for v in p[2:])
    except FileNotFoundError: pass
    if not probes: return probes
    ox = min(v[0] for v in probes.values()); oy = min(v[1] for v in probes.values())
    return collections.OrderedDict((k, (v[0]-ox, v[1]-oy, v[2], v[3])) for k, v in probes.items())
cols = [("Apple", load("ExpApple")), ("SwiftUI2/mac", load("Exp2")), ("Android", load("android"))]
names = list(dict.fromkeys(k for _, c in cols for k in c))
f = lambda v: "-" if v is None else "%6.1f %6.1f %6.1f %5.1f" % v
print("%-16s" % "probe" + "".join("%-30s" % n for n, _ in cols))
for k in names: print("%-16s" % k + "".join("%-30s" % f(c.get(k)) for _, c in cols))
PY
